# Minimal Penpot backend configuration for offline desktop use.
# All data is stored locally on the PC.

PENPOT_TENANT=default
PENPOT_HOST=localhost
PENPOT_PUBLIC_URI=http://localhost:3449

# HTTP server
PENPOT_HTTP_SERVER_PORT=3449
PENPOT_HTTP_SERVER_HOST=localhost

# Database (PostgreSQL running locally)
PENPOT_DATABASE_URI=postgresql://localhost/penpot
PENPOT_DATABASE_USERNAME=penpot
PENPOT_DATABASE_PASSWORD=penpot

# Redis (running locally)
PENPOT_REDIS_URI=redis://localhost/0

# Local file storage for assets
PENPOT_OBJECTS_STORAGE_BACKEND=fs
PENPOT_OBJECTS_STORAGE_FS_DIRECTORY=data/assets
PENPOT_STORAGE_ASSETS_FS_DIRECTORY=data/assets
PENPOT_ASSETS_PATH=/internal/assets/

# Fixed secret for the local desktop build.
PENPOT_SECRET_KEY=desktop-local-secret-key-change-in-production

# Feature flags for offline / single-user desktop
PENPOT_FLAGS=disable-secure-session-cookies disable-email-verification disable-google-fonts-provider disable-dashboard-templates-section disable-telemetry enable-backend-worker enable-demo-users enable-cors

# Disable external services we do not need
PENPOT_TELEMETRY_ENABLED=false

# Allow the Tauri-hosted frontend (dev server and built app origins)
PENPOT_ALLOWED_ORIGINS=http://localhost:1420 http://localhost:3449
