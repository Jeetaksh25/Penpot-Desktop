{
  "$schema": "https://raw.githubusercontent.com/JonasKruckenberg/tauri/next/core/tauri-config-schema/schema.json",
  "productName": "Penpot Desktop",
  "version": "1.0.28",
  "identifier": "com.penpot.desktop",
  "build": {
    "beforeDevCommand": "npm run serve:penpot",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "node scripts/generate-icons.mjs",
    "frontendDist": "./embed"
  },
  "app": {
    "windows": [],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "nsis",
    "license": "MPL-2.0",
    "licenseFile": "../penpot-source/LICENSE",
    "icon": [
      "icons/icon.ico",
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png"
    ],
    "resources": {
      "../penpot-source/backend/target/penpot.jar": "penpot-source/backend/target/penpot.jar",
      "../penpot-source/frontend/resources/public": "public/",
      "../tools/postgres/bin": "tools/postgres/bin/",
      "../tools/postgres/lib": "tools/postgres/lib/",
      "../tools/postgres/share": "tools/postgres/share/",
      "../tools/redis/Redis-8.8.0-Windows-x64-msys2": "tools/redis/Redis-8.8.0-Windows-x64-msys2/",
      "../tools/jre": "tools/jre/",
      "../tools/imagemagick": "tools/imagemagick/",
      "../data/builtin-templates": "builtin-templates/"
    },
    "windows": {
      "wix": null,
      "nsis": {
        "installMode": "currentUser",
        "installerIcon": "icons/icon.ico",
        "installerHooks": "installer.nsh",
        "languages": [
          "English"
        ],
        "displayLanguageSelector": false,
        "startMenuFolder": "Penpot Desktop",
        "template": null
      }
    }
  }
}
