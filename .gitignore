# ── Dependencies ──────────────────────────────────────────────────────────
/node_modules
/penpot-source/**/node_modules
/penpot-source/**/package-lock.json
# Root package-lock.json is committed for reproducible CI (npm ci).
# /package-lock.json

# ── Build output ──────────────────────────────────────────────────────────
/src-tauri/target
/penpot-source/**/target
/penpot-source/**/.shadow-cljs
/penpot-source/**/dist
/penpot-source/**/resources/public/*
!/penpot-source/**/resources/public/index.html
/penpot-source/**/.cpcache
/penpot-source/**/.nrepl-port
/dist

# ── JAR artifacts (built in CI) ───────────────────────────────────────────
/penpot-source/**/*.jar

# ── Cargo lockfiles (reproducible builds) ─────────────────────────────────
# Uncomment if you prefer deterministic Cargo builds:
# /src-tauri/Cargo.lock
/penpot-source/**/Cargo.lock

# ── Runtime data (local dev only) ─────────────────────────────────────────
/tools/data
data/postgres
data/redis
data/builtin-templates
*.db

# ── Tooling binaries (downloaded in CI) ───────────────────────────────────
/tools/postgres
/tools/redis
/tools/jre
/tools/emsdk
/tools/.emsdk_cache
*.log

# ── OS / Editor cruft / reserved names ──────────────────────────────────
.DS_Store
Thumbs.db
*.local
*.tmp
# Windows reserved device names (may be created by MSYS2/Git Bash)
nul
CON
PRN
AUX
CLOCK$
COM1
COM2
LPT1
LPT2

# ── IDE / AI ──────────────────────────────────────────────────────────────
/.claude
/.serena

# ── temp tooling (untracked, removed at C5) ──
scan2.py
__pycache__/
*.pyc
