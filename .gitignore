# /src-tauri/Cargo.lock
/penpot-source/**/Cargo.lock

# ── Runtime data (local dev only) ─────────────────────────────────────────
/tools/data
/data
*.db

# ── Tooling binaries (downloaded in CI) ───────────────────────────────────
/tools/postgres
/tools/redis
/tools/emsdk
/tools/.emsdk_cache
*.log

# ── OS / Editor cruft ─────────────────────────────────────────────────────
.DS_Store
Thumbs.db
*.local
*.tmp

# ── IDE / AI ──────────────────────────────────────────────────────────────
/.claude
/.serena
